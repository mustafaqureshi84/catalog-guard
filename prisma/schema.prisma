// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)

  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// A supplier feed the merchant has connected.
///
/// Scoped by `shop` because one deployment serves many stores — unlike the
/// single-store scripts this project's sibling repo contains, every query
/// here must filter by shop or one merchant sees another's data.
model FeedConnection {
  id   String @id @default(uuid())
  shop String

  name String
  url  String

  /// csv is the only supported format for now. XML, JSON, and FTP are
  /// roadmap items; the parsing layer is the only part that differs.
  format String @default("csv")

  /// Set false to stop syncing without losing the configuration and history.
  enabled Boolean @default(true)

  lastFetchedAt DateTime?
  lastRowCount  Int?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs       FeedRun[]
  mappings   FieldMapping[]
  shadowRuns ShadowRun[]

  @@index([shop])
}

/// One row per fetch attempt. Records failures as well as successes — a
/// feed that silently stopped updating is the failure merchants notice last
/// and care about most.
model FeedRun {
  id     String @id @default(uuid())
  feedId String

  /// running | completed | failed
  status String @default("running")

  rowCount    Int?
  columnNames String?
  bytes       Int?
  error       String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  feed FeedConnection @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@index([feedId, startedAt])
}

/// Maps one supplier column to one Shopify field, and records who owns it.
///
/// Ownership is the point of the product. A merchant will not hand 4,000
/// records to automation unless they can say "the supplier controls price
/// and stock; nothing touches my titles."
///
/// The unique constraint on (feedId, targetField) allows only one supplier
/// column per Shopify field. Two columns competing for the same target is a
/// conflict with no obvious resolution, so it is rejected at the schema
/// level rather than resolved at write time.
model FieldMapping {
  id     String @id @default(uuid())
  feedId String

  /// Column name as it appears in the CSV, lowercased and trimmed to match
  /// the parser's transformHeader.
  sourceColumn String

  /// Shopify field: sku | price | compareAtPrice | cost | inventory | barcode
  targetField String

  /// supplier — the feed may write this field
  /// merchant  — the feed may never write this field, whatever it contains
  owner String @default("supplier")

  /// string | decimal | integer. Every CSV value arrives as a string, so
  /// coercion is a decision made here rather than inferred at write time.
  dataType String @default("string")

  createdAt DateTime @default(now())

  feed FeedConnection @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, targetField])
  @@index([feedId])
}

/// One shadow-mode evaluation of a feed against the live catalogue.
///
/// Recorded rather than computed on demand so a merchant can review, leave,
/// and come back — and so the eventual apply step acts on a concrete
/// artefact rather than re-deriving the diff and risking a different answer
/// against a catalogue that moved in between.
model ShadowRun {
  id     String @id @default(uuid())
  feedId String
  shop   String

  /// running | completed | failed
  status String @default("running")

  rowsInFeed    Int @default(0)
  rowsMatched   Int @default(0)
  rowsUnmatched Int @default(0)
  rowsAmbiguous Int @default(0)
  rowsInvalid   Int @default(0)

  fieldsChanged   Int @default(0)
  fieldsUnchanged Int @default(0)
  fieldsBlocked   Int @default(0)

  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  feed    FeedConnection @relation(fields: [feedId], references: [id], onDelete: Cascade)
  changes ShadowChange[]

  @@index([feedId, startedAt])
}

/// One proposed field change, or one reason a row could not produce any.
///
/// Rows that fail to match or coerce are recorded rather than skipped. A
/// silent skip is how a feed appears to sync successfully while ignoring a
/// third of the catalogue.
model ShadowChange {
  id          String @id @default(uuid())
  shadowRunId String

  sku String

  /// Null when the row could not be matched to a variant.
  variantGid String?
  productGid String?

  targetField   String
  currentValue  String?
  proposedValue String?

  /// changed | unchanged | blocked | unmatched | ambiguous | invalid
  verdict String

  note String?

  shadowRun ShadowRun @relation(fields: [shadowRunId], references: [id], onDelete: Cascade)

  @@index([shadowRunId, verdict])
}